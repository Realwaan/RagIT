# Primary Fast API (Groq)
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Optional Fallback (Google Gemini OpenAI-compatible endpoint)
FALLBACK_API_KEY=AIzaSy_your_gemini_key_here
FALLBACK_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FALLBACK_MODEL=gemini-2.5-flash

# Visual analysis defaults to the fallback endpoint/key/model above.
# Images are analyzed in the background and checked again for visual answers.
VISION_ENABLED=true
VISION_TIMEOUT_SECONDS=45
# VISION_API_KEY=your_vision_key
# VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# VISION_MODEL=gemini-2.5-flash

# Local Embeddings (Keep embeddings local so you don't burn API limits!)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=32

# Guardrail & Retrieval Parameters
SIMILARITY_THRESHOLD=0.50
TOP_K=4

# Maximum Document Upload Size (500 MB)
MAX_UPLOAD_SIZE_BYTES=524288000
